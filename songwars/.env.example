# Kopier til .env og udfyld. .env maa aldrig i git (den er i .gitignore).
#
#   cp .env.example .env && chmod 600 .env

# Signerer session-cookien. Skift den, og alle bliver smidt ud af deres lobbyer.
# Lav en med:  python3 -c "import secrets; print(secrets.token_hex(32))"
SONGWARS_SECRET_KEY=

# Admin-login til genrer og beats. Mindst 12 tegn.
SONGWARS_ADMIN_PASSWORD=

# Saet til 0 KUN hvis du koerer uden HTTPS (fx lokalt). Ellers kan man
# ikke logge ind, fordi cookien kun sendes over https.
SONGWARS_COOKIE_SECURE=1

# Headeren med brugerens rigtige IP, til rate limiting. Bag Cloudflare er
# det CF-Connecting-IP. Uden Cloudflare: X-Real-IP (som nginx saetter).
SONGWARS_IP_HEADER=CF-Connecting-IP

# Graenser. Standardvaerdierne er dem der staar her.
SONGWARS_MAX_UPLOAD_MB=50
SONGWARS_MAX_BEAT_MB=95
SONGWARS_LOBBY_HOURS=24
SONGWARS_KEEP_DAYS=7
SONGWARS_SPIN_SECONDS=20
SONGWARS_YT_MAX_MINUTES=15
SONGWARS_REVEAL_SECONDS=10
SONGWARS_GRACE_SECONDS=10
SONGWARS_EXTRA_SECONDS=120
SONGWARS_VOTE_MINUTES_PER_TRACK=2
