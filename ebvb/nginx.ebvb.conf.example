# EBVB paa ebvb.dk.
#
# Det her matcher opsaetningen i ~/stack: nginx koerer selv i en
# container og publicerer 80/443 paa vaerten. App-containeren er IKKE
# publiceret til vaerten - den er kun naabar inde paa Dockers netvaerk
# (stack_web). Det er med vilje: appen kan ikke naas udenom nginx.
#
#   Bruger -> Cloudflare -> nginx-container (443) -> ebvb-container (8090)
#
# Filen hoerer til i ~/stack/nginx/conf.d/musik.conf, som er mountet ind
# i containeren paa /etc/nginx/conf.d. Efter en aendring:
#
#   docker exec nginx nginx -t
#   docker exec nginx nginx -s reload
#
# Certifikatet er Cloudflare Origin CA fra /etc/ssl/cloudflare. Ret
# filnavnene herunder til dem der faktisk ligger i den mappe.

server {
    listen 80;
    listen [::]:80;
    server_name ebvb.dk www.ebvb.dk;
    return 301 https://ebvb.dk$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ebvb.dk;

    ssl_certificate     /etc/ssl/cloudflare/ebvb.dk.pem;
    ssl_certificate_key /etc/ssl/cloudflare/ebvb.dk.key;

    # Samme graense som MAX_BYTES i app.py. De to skal folges ad.
    #
    # ADVARSEL: Cloudflares gratis- og Pro-planer afviser request bodies
    # over 100 MB, for de naar herned. Denne linje alene giver jer altsaa
    # ikke 512 MB uploads. Se DEPLOY.md.
    client_max_body_size 512M;

    client_body_timeout 300s;
    proxy_read_timeout  300s;
    proxy_send_timeout  300s;

    location / {
        # 127.0.0.11 er Dockers indbyggede DNS. Naar proxy_pass
        # indeholder en variabel, udskyder nginx navneopslaget til
        # forespoergselstidspunktet i stedet for kun at gore det en gang
        # ved indlaesning.
        #
        # Uden det her holder nginx fast i den IP app-containeren havde
        # da konfigurationen blev laest. Hvert deploy med --build
        # genskaber containeren og giver den en ny IP, og saa svarer
        # siden 502 indtil nginx bliver genlaest. Med variablen sker det
        # af sig selv - ogsaa efter en genstart hvor containerne kommer
        # op i tilfaeldig raekkefolge.
        resolver 127.0.0.11 valid=10s;
        set $ebvb_upstream ebvb:8090;
        proxy_pass http://$ebvb_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Lyd hentes med Range-forespoergsler. Bufring her ville tvinge
        # nginx til at hente hele filen for den sender noget videre, og
        # saa kan man ikke spole i en 40 MB wav.
        proxy_buffering off;
    }

    gzip             on;
    gzip_vary        on;
    gzip_min_length  512;
    gzip_types       text/plain text/css application/javascript image/svg+xml;

    add_header X-Content-Type-Options "nosniff"     always;
    add_header X-Frame-Options        "DENY"        always;
    add_header Referrer-Policy        "same-origin" always;

    # Siden henter kun to fonte udefra. Selvhoster du dem (se README),
    # kan style-src og font-src skaeres ned til 'self'.
    add_header Content-Security-Policy
        "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'" always;

    server_tokens off;
}
